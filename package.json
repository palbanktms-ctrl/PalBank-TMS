{
  "name": "palbank-tms",
  "version": "1.0.1",
  "description": "PalBank TMS - Logiciel de gestion de transport",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build-win": "electron-builder --win"
  },
  "author": "PalBank",
  "license": "MIT",
  "devDependencies": {
    "electron": "^22.0.0",
    "electron-builder": "^24.0.0"
  },
"build": {
  "appId": "com.palbank.tms",
  "productName": "PalBank TMS",
  "directories": {
    "output": "dist"
  },
  "files": [
    "**/*",
    "!node_modules",
    "!dist"
  ],
  "publish": {
    "provider": "github",
    "owner": "palbanktms-ctrl",
    "repo": "PalBank-TMS"
  },
  "win": {
    "target": "nsis",
    "icon": "icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "mac": {
    "target": "dmg",
    "icon": "icon.png"
  }
}
}
